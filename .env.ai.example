# AI provider: anthropic | openai | ollama
AI_PROVIDER=anthropic

# API key for the provider
# Anthropic: get from https://console.anthropic.com
# OpenAI: get from https://platform.openai.com
# Ollama: any non-empty string (e.g. "ollama")
AI_API_KEY=

# LLM model ID
# Anthropic: claude-haiku-4-5-20251001 | claude-sonnet-4-6
# OpenAI: gpt-4o-mini | gpt-4o
# Ollama: llama3 | mistral
AI_MODEL=claude-haiku-4-5-20251001

# Base URL for OpenAI-compatible endpoints (leave empty for default)
# Ollama default: http://localhost:11434/v1
# OpenAI: https://api.openai.com (default, no need to set)
AI_BASE_URL=

# Embedding model (used for semantic search and related posts)
# OpenAI/compatible: text-embedding-3-small | text-embedding-3-large
# Ollama: nomic-embed-text
# Anthropic users: set AI_BASE_URL + AI_API_KEY to an OpenAI-compatible endpoint
AI_EMBEDDING_MODEL=text-embedding-3-small

# PostgreSQL (when using docker-compose.ai.yml)
POSTGRES_PASSWORD=sonic
